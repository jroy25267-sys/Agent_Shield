# ==========================================
# AgentShield Enterprise Configuration (.env)
# ==========================================

# 1. Server & Security Gateway Ports
PORT=3000
NODE_ENV=development

# 2. AgentShield Token Encryption & Session Secret
# Generate a 32-byte hex string: openssl rand -hex 32
AGENTSHIELD_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
AGENTSHIELD_SESSION_SECRET="super-secure-agentshield-session-secret-key-32chars"

# 3. Google Cloud OAuth 2.0 Credentials (Google Identity Services & Gmail API)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/gmail/oauth/callback"

# 4. Frontend Vite Environment Variable (Required for Google Identity Services frontend rendering)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# 5. Gemini AI Key for LLM Reasoning (Optional, falls back to deterministic rule engine)
GEMINI_API_KEY=""

# 6. App Deployment URL
APP_URL="http://localhost:3000"
